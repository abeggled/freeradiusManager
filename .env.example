# Beispielkonfiguration fuer docker compose. Kopieren nach .env und anpassen.

# --- Datenbank -------------------------------------------------------------
DB_NAME=radius
DB_USER=radmgr
DB_PASSWORD=bitte-ersetzen
DB_ROOT_PASSWORD=bitte-ersetzen
DB_PORT=13306

# --- Manager ---------------------------------------------------------------
MANAGER_PORT=8000
FRM_ENVIRONMENT=production

# Pflicht. Signierschluessel der Session-Tokens; ohne Wert startet der Stapel
# nicht. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FRM_SECRET_KEY=

# Pflicht. Schluessel fuer CoA- und TOTP-Secrets (AES-GCM). Erzeugen mit:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
FRM_COA_SECRET_KEY=

# Nur auf false setzen, wenn ohne TLS-Reverse-Proxy getestet wird.
FRM_COOKIE_SECURE=true

# Netze der vorgelagerten Reverse-Proxys (kommagetrennt). Nur von dort wird
# X-Forwarded-For ausgewertet; ohne Eintrag zaehlt die direkte Peer-Adresse.
# Ein leerer Wert ist die sichere Vorgabe - sonst liessen sich die Rate-Limits
# mit gefaelschten Headern umgehen.
# FRM_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Wird ausschliesslich verwendet, solange noch kein Administrator existiert.
FRM_BOOTSTRAP_ADMIN_USERNAME=admin
FRM_BOOTSTRAP_ADMIN_PASSWORD=

# aa:bb:cc:dd:ee:ff | aabbccddeeff | AA-BB-CC-DD-EE-FF | aabb.ccdd.eeff …
FRM_DEFAULT_MAC_FORMAT=colon_lower

# --- Optional: OIDC --------------------------------------------------------
# FRM_OIDC_ENABLED=true
# FRM_OIDC_ISSUER=https://login.example.org/realms/intern
# FRM_OIDC_CLIENT_ID=freeradius-manager
# FRM_OIDC_CLIENT_SECRET=
# FRM_OIDC_REDIRECT_URL=https://radius.example.org/api/v1/auth/oidc/callback
# FRM_OIDC_ROLE_MAP={"radius-admins":"administrator","helpdesk":"operator"}

# --- FreeRADIUS-Container (nur Evaluierung) --------------------------------
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
